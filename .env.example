# wewed — Environment Variables
#
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env`, `.env.local`, or any file containing real secrets.

# ── Database ──────────────────────────────────────────────────
# Runtime/serverless connection: Supabase transaction pooler (port 6543)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migration connection: Supabase session pooler (port 5432)
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ── Supabase public browser configuration ─────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# ── Supabase server secret ─────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── Signed application sessions ────────────────────────────────
# Recommended: generate with `openssl rand -base64 48`.
# When omitted, the server falls back to SUPABASE_SERVICE_ROLE_KEY.
WEWED_SESSION_SECRET="your-random-server-only-session-secret"

# ── Site URL ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Protected scheduled jobs ──────────────────────────────────
# Vercel Cron sends this value as Authorization: Bearer <CRON_SECRET>.
# Production reminder and notification-delivery crons fail closed without it.
CRON_SECRET=""

# ── Transactional email (Resend outbound, server-only) ─────────
# Production outbound stays disabled unless the API key, valid sender mailbox,
# and valid reply-to mailbox are configured. Wewed normalizes common angle-bracket
# entry mistakes but still fails closed when no valid mailbox can be extracted.
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
WEWED_EMAIL_FROM="Wewed <notifications@updates.wewed.pro>"
# Cloudflare Email Routing should forward this address to the monitored inbox.
WEWED_EMAIL_REPLY_TO="support@wewed.pro"

# ── Communications dispatch and WhatsApp Cloud API ─────────────
# Server-only key for the protected communications queue dispatcher.
# Recommended: generate with `openssl rand -hex 32`.
WEWED_COMMUNICATIONS_DISPATCH_KEY=""

# Meta System User token. Never expose this through NEXT_PUBLIC_ variables.
WHATSAPP_CLOUD_ACCESS_TOKEN=""
WHATSAPP_CLOUD_PHONE_NUMBER_ID="1262607510266445"
WHATSAPP_CLOUD_GRAPH_VERSION="v26.0"
# Optional override. Leave empty to use https://graph.facebook.com.
WHATSAPP_CLOUD_GRAPH_BASE_URL=""

# Existing approved proactive communication template.
WEWED_WHATSAPP_NOTIFICATION_TEMPLATE="wewed_new_message_v1"
WEWED_WHATSAPP_TEMPLATE_LANGUAGE="en_US"

# Recommended dedicated notification action template. Its approved Meta contract is:
# Body {{1}} = Wewed notification title/context
# URL button 0 = https://wewed.pro/notifications/open/{{1}}
# Wewed sends only the opaque Notification id as the dynamic URL suffix, and the open route
# rechecks current recipient/source authorization before marking read and redirecting.
WEWED_WHATSAPP_ACTION_TEMPLATE=""

# Temporary Meta test-number qualification mode. Keep false outside a controlled
# qualification window. When true, only normalized E.164 numbers explicitly
# listed in WEWED_WHATSAPP_TEST_RECIPIENTS may receive the parameter-free test
# template (normally Meta's pre-approved hello_world). Non-allowlisted sends fail closed.
WEWED_WHATSAPP_TEST_MODE="false"
WEWED_WHATSAPP_TEST_TEMPLATE="hello_world"
WEWED_WHATSAPP_TEST_RECIPIENTS=""

# Public webhook verification token + Meta App Secret, both server-only.
# Generate the verify token with `openssl rand -hex 32`; obtain the App Secret
# from the Wewed Meta app. Never paste either value into source control.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_WEBHOOK_APP_SECRET=""

# ── Standards-based Web Push / PWA notifications ──────────────
# Generate one P-256 VAPID key pair and keep the private key server-only.
# Public/private values are unpadded base64url-encoded raw P-256 keys:
# public = 65-byte uncompressed point, private = 32-byte scalar.
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=""
WEWED_WEB_PUSH_VAPID_PRIVATE_KEY=""
# VAPID contact identity must be mailto:... or an https: URL.
WEWED_WEB_PUSH_VAPID_SUBJECT="mailto:support@wewed.pro"

# Optional compatibility gateway. Direct Wewed Web Push is preferred when a valid
# VAPID key pair is configured; these values are only used as a fallback.
WEWED_PUSH_GATEWAY_URL=""
WEWED_PUSH_GATEWAY_TOKEN=""

# ── Telegram bot webhook (optional, server-only) ────────────────
# Leave both empty when Telegram is not active. If enabled, register the bot
# webhook at https://wewed.pro/api/telegram and pass TELEGRAM_WEBHOOK_SECRET as
# Telegram's setWebhook `secret_token`. Wewed rejects unsigned webhook posts.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""

# ── AI provider routing (server-only) ─────────────────────────
# Never prefix an AI key with NEXT_PUBLIC_. Wewed defaults to GLM through Z.AI.
AI_ENABLED="true"
AI_PRIVATE_PROVIDER="zai"
AI_QUALITY_PROVIDER="zai"
AI_FALLBACK_PROVIDER="groq"

# Keep false for real wedding data. Private wedding context must not move to a
# fallback provider unless an explicit privacy review approves that route.
AI_ALLOW_PRIVATE_FALLBACK="false"

# Provider credentials. Create these manually in each provider console.
ZAI_API_KEY=""
GROQ_API_KEY=""
GEMINI_API_KEY=""

# Free/default text models. GLM 4.7 Flash remains the text default until a paid
# text model is deliberately enabled and validated.
ZAI_MODEL="glm-4.7-flash"
GROQ_MODEL="openai/gpt-oss-120b"
GEMINI_MODEL="gemini-3.6-flash"

# Optional endpoint overrides for compatible proxies or self-hosting.
ZAI_BASE_URL="https://api.z.ai/api/paas/v4"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"

# Safety, timeout, retry and quota controls.
AI_REQUEST_TIMEOUT_MS="30000"
AI_PROVIDER_MAX_RETRIES="2"
AI_MAX_OUTPUT_TOKENS="2048"

# ── Notebook voice transcription (server-only) ─────────────────
# Optional dedicated override. When omitted, Notebook first reuses Wewed's
# configured private Z.AI credential and its /audio/transcriptions endpoint.
# Z.AI meeting capture uses bounded private WAV chunks while the full browser
# WebM recording is retained in Wewed's private Notebook storage. If Z.AI is not
# configured, GROQ_API_KEY is used only when AI_ALLOW_PRIVATE_FALLBACK=true.
# No provider credential is ever exposed to the browser.
WEWED_TRANSCRIPTION_URL=""
WEWED_TRANSCRIPTION_API_KEY=""
# Leave empty for provider-aware defaults: glm-asr-2512 on Z.AI or, when private
# fallback is explicitly allowed, whisper-large-v3-turbo on Groq.
WEWED_TRANSCRIPTION_MODEL=""

# Preview write isolation. Set only to the database ID of a dedicated UAT
# wedding. Without this value, AI workspace writes are blocked in Preview.
WEWED_PREVIEW_WRITABLE_WEDDING_ID=""
