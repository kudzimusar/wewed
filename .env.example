# wewed — Environment Variables
#
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env`, `.env.local`, or any file containing real secrets.

# ── Database ──────────────────────────────────────────────────
# Runtime/serverless connection: Supabase transaction pooler (port 6543)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migration connection: Supabase session pooler (port 5432)
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ── Supabase public browser configuration ─────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# ── Supabase server secret ─────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── Signed application sessions ────────────────────────────────
# Recommended: generate with `openssl rand -base64 48`.
# When omitted, the server falls back to SUPABASE_SERVICE_ROLE_KEY.
WEWED_SESSION_SECRET="your-random-server-only-session-secret"

# ── Site URL ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── AI provider routing (server-only) ─────────────────────────
# Never prefix an AI key with NEXT_PUBLIC_.
AI_ENABLED="true"
AI_PRIVATE_PROVIDER="groq"
AI_QUALITY_PROVIDER="gemini"
AI_FALLBACK_PROVIDER="zai"

# Keep false for real wedding data. When false, private requests do not move
# from Groq to Gemini/Z.AI if Groq is unavailable.
AI_ALLOW_PRIVATE_FALLBACK="false"

# Provider credentials. Create these manually in each provider console.
GROQ_API_KEY=""
GEMINI_API_KEY=""
ZAI_API_KEY=""

# Current stable/free model defaults. Override here without changing code.
GROQ_MODEL="openai/gpt-oss-120b"
GEMINI_MODEL="gemini-3.6-flash"
ZAI_MODEL="glm-4.7-flash"

# Optional endpoint overrides for compatible proxies or self-hosting.
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
ZAI_BASE_URL="https://api.z.ai/api/paas/v4"

# Safety and quota controls.
AI_REQUEST_TIMEOUT_MS="30000"
AI_MAX_OUTPUT_TOKENS="2048"
