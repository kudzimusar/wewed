# wewed — Environment Variables
#
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env`, `.env.local`, or any file containing real secrets.
#
# See SUPABASE_SETUP.md for instructions on obtaining Supabase credentials.

# ── Database ──────────────────────────────────────────────────
# Local dev (SQLite):
DATABASE_URL="file:./db/custom.db"
#
# Production (Supabase PostgreSQL — use the pooling URL from Supabase dashboard):
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# ── Supabase (public — safe for browser) ──────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# ── Supabase (SECRET — server only, never expose to browser) ──
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── Site URL (for auth redirects) ─────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Admin password (optional override) ────────────────────────
# The couple login password. Defaults to "wewed-admin-2026" if not set.
# NEXT_PUBLIC_WEWED_ADMIN_PASSWORD="your-secure-password"
