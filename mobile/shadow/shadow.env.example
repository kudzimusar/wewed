# Wewed Mobile Shadow example environment.
# Copy to a private, ignored environment file. Never place real secrets here.

WEWED_NATIVE_ENV=shadow
WEWED_SHADOW_API_BASE_URL=http://127.0.0.1:8787
WEWED_SHADOW_DATABASE_URL=postgresql://shadow_user:REPLACE_LOCALLY@127.0.0.1:5432/wewed_mobile_shadow

# Hard safety controls
WEWED_ALLOW_PRODUCTION_WRITES=false
WEWED_ALLOW_REAL_EMAIL=false
WEWED_ALLOW_REAL_WHATSAPP=false
WEWED_ALLOW_REAL_PUSH=false
WEWED_ALLOW_LIVE_PAYMENTS=false
WEWED_ALLOW_BINDING_CONTRACTS=false
WEWED_ALLOW_EXTERNAL_WEBHOOKS=false

# Production discovery credentials are intentionally absent.
# Read-only discovery must use a separate authorized mechanism and must
# never be loaded into a native client runtime.
