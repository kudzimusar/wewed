<?xml version="1.0" encoding="utf-8"?>
<!--
  Wewed adaptive launcher icon.

  The background is the brand ivory rather than white, so the mask the launcher applies (circle,
  squircle, teardrop) always reveals the same ground the mark was drawn on. The foreground is the
  mark inset into the 66% safe zone, so the rings and botanicals are never clipped.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/wewed_ivory" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
