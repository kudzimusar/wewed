<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-API-31 launch window. Ivory ground, brand mark centred, no motion: the OS draws this before
  any application code runs, so anything animated here would be a still frame anyway.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/wewed_ivory" />
    <item android:gravity="center">
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher_foreground" />
    </item>
</layer-list>
