generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Couple {
  id                 String   @id @default(cuid())
  slug               String   @unique
  partner1           String
  partner2           String
  surname            String?
  photo              String?
  userId             String?
  subscriptionStatus String   @default("free")

  weddings   Wedding[]
  kids       Kid[]
  users      User[]
  userProfile UserProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Wedding {
  id           String  @id @default(cuid())
  slug         String  @unique
  title        String
  monogram     String?
  tagline      String?
  date         DateTime
  venue        String
  venueCity    String
  venueCountry String
  venueMapUrl  String?

  primaryColor    String @default("#BF9B5F")
  accentColor     String @default("#C0633F")
  memoryColor     String @default("#6B2D3A")
  backgroundColor String @default("#FBF6EE")

  invitationCardStyle   String    @default("botanical")
  invitationCardMessage String?
  rsvpDeadline          DateTime?

  lifecycle       String    @default("before")
  privacy         String    @default("public")
  canonSealed     Boolean   @default(false)
  canonSealedAt   DateTime?
  subscriptionTier String   @default("free")

  coupleId String
  couple   Couple @relation(fields: [coupleId], references: [id])

  guests                  Guest[]
  songs                   Song[]
  media                   MediaItem[]
  messages                Message[]
  products                Product[]
  vendors                 Vendor[]
  programmeItems          ProgrammeItem[]
  plannerTasks            PlannerTask[]
  budgetItems             BudgetItem[]
  seatingTables           SeatingTable[]
  importJobs              ImportJob[]
  contentRevisions        ContentRevision[]
  contentSubmissions      ContentSubmission[]
  auditEvents             AuditEvent[]
  googleSheetsConnections GoogleSheetsConnection[]
  qrDestinations          QRDestination[]
  themePreferences        ThemePreference[]
  guestContributions      GuestContribution[]
  contentItems            WeddingContent[]
  comments                Comment[]
  memberships             WeddingMembership[]
  currentForUsers         User[] @relation("CurrentWedding")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Guest {
  id                  String  @id @default(cuid())
  name                String
  email               String?
  phone               String?
  role                String  @default("guest")
  roleDetail          String?
  side                String?
  tableNumber         Int?
  seatingTableId      String?
  seatingTable        SeatingTable? @relation(fields: [seatingTableId], references: [id])
  contributionToken   String? @unique
  contributionStatus  String? @default("none")

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])

  rsvp         RSVP?
  contribution GuestContribution?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RSVP {
  id             String   @id @default(cuid())
  token          String   @unique
  attending      Boolean?
  mealChoice     String?
  plusOne        Boolean  @default(false)
  plusOneName    String?
  plusOneMeal    String?
  kidsAttending  Boolean  @default(false)
  kidsCount      Int      @default(0)
  songRequests   String?
  dietaryNotes   String?
  message        String?
  checkedIn      Boolean  @default(false)
  checkedInAt    DateTime?

  guestId String @unique
  guest   Guest  @relation(fields: [guestId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Song {
  id         String    @id @default(cuid())
  title      String
  artist     String
  phase      String
  moment     String?
  order      Int       @default(0)
  votes      Int       @default(0)
  spotifyUrl String?
  appleUrl   String?
  playedAt   DateTime?
  notes      String?

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MediaItem {
  id           String    @id @default(cuid())
  type         String
  url          String
  thumbnailUrl String?
  caption      String?
  moment       String?
  isCurated    Boolean   @default(false)
  isHero       Boolean   @default(false)
  uploaderId   String?
  userId       String?
  user         UserProfile? @relation(fields: [userId], references: [id])
  uploadedAt   DateTime?

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id          String    @id @default(cuid())
  type        String
  content     String
  authorName  String
  authorToken String?
  userId      String?
  user        UserProfile? @relation(fields: [userId], references: [id])
  isPublic    Boolean   @default(true)
  revealedAt  DateTime?

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String  @id @default(cuid())
  name        String
  description String?
  price       Float
  currency    String  @default("USD")
  imageUrl    String?
  category    String?
  inStock     Boolean @default(true)

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vendor {
  id             String  @id @default(cuid())
  name           String
  category       String
  description    String?
  website        String?
  phone          String?
  imageUrl        String?
  rating         Float?
  featured       Boolean @default(false)
  contact        String?
  contractStatus String  @default("pending")
  paymentStatus  String  @default("unpaid")
  planningRating Float?
  notes          String?

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProgrammeItem {
  id          String @id @default(cuid())
  time        String
  title       String
  description String?
  icon        String?
  duration    String?
  location    String?
  displayIcon String?
  order       Int    @default(0)

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Kid {
  id       String @id @default(cuid())
  name     String
  gender   String
  age      Int?
  photoUrl String?

  coupleId String
  couple   Couple @relation(fields: [coupleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlannerTask {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String
  status      String   @default("todo")
  priority    String   @default("medium")
  dueDate     DateTime?
  assignee    String?
  assignedToUserId String?
  assignedToUser   User? @relation("PlannerTaskAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BudgetItem {
  id          String   @id @default(cuid())
  category    String
  item        String
  estimated   Float
  actual      Float?
  paid        Float    @default(0)
  vendor      String?
  dueDate     DateTime?
  status      String   @default("estimated")
  notes       String?

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SeatingTable {
  id       String @id @default(cuid())
  name     String
  number   Int
  capacity Int
  shape    String @default("round")

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])
  guests    Guest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([weddingId, number])
}

model ImportJob {
  id              String    @id @default(cuid())
  moduleKey       String
  fileName        String
  templateVersion String?
  status          String    @default("preview")
  totalRows       Int       @default(0)
  createdCount    Int       @default(0)
  updatedCount    Int       @default(0)
  skippedCount    Int       @default(0)
  errorCount      Int       @default(0)
  fieldMapping    String?
  previewData     String?
  errorReport     String?
  rollbackToken   String?   @unique
  rollbackData    String?
  executedAt      DateTime?
  rolledBackAt    DateTime?

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([weddingId, moduleKey, createdAt])
}

model ContentRevision {
  id          String    @id @default(cuid())
  section     String
  field       String
  value       String
  status      String    @default("draft")
  publishedAt DateTime?
  publishedBy String?

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContentSubmission {
  id          String    @id @default(cuid())
  type        String
  content     String
  submittedBy String?
  status      String    @default("pending")
  reviewedAt  DateTime?
  reviewedBy  String?

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditEvent {
  id            String   @id @default(cuid())
  action        String
  resourceType  String
  resourceId    String?
  beforeValue   String?
  afterValue    String?
  actorId       String?
  actorIp       String?
  actorUserAgent String?

  weddingId String?
  wedding   Wedding? @relation(fields: [weddingId], references: [id])

  createdAt DateTime @default(now())
}

model GoogleSheetsConnection {
  id            String    @id @default(cuid())
  spreadsheetId String
  sheetName     String
  lastSyncAt    DateTime?
  syncStatus    String    @default("pending")
  errorMessage  String?

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QRDestination {
  id          String @id @default(cuid())
  label       String
  destination String
  shortCode   String @unique
  scanCount   Int    @default(0)

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ThemePreference {
  id        String @id @default(cuid())
  deviceId  String
  theme     String @default("light")
  lifecycle String @default("before")

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([weddingId, deviceId])
}

model GuestContribution {
  id          String    @id @default(cuid())
  type        String
  content     String
  mediaUrl    String?
  caption     String?
  authorName  String
  status      String    @default("pending")
  isPublic    Boolean   @default(false)
  reviewedAt  DateTime?
  reviewedBy  String?

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])

  guestId String @unique
  guest   Guest  @relation(fields: [guestId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WeddingContent {
  id       String @id @default(cuid())
  section  String
  field    String
  value    String
  order    Int    @default(0)
  metadata String?

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([weddingId, section, field])
  @@index([weddingId, section, order])
}

model UserProfile {
  id        String  @id @default(cuid())
  email     String  @unique
  fullName  String
  avatarUrl String?
  bio       String?
  role      String  @default("guest")

  coupleId String? @unique
  couple   Couple? @relation(fields: [coupleId], references: [id])

  media    MediaItem[]
  messages Message[]
  comments Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comment {
  id      String @id @default(cuid())
  content String

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  userId String
  user   UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([weddingId, createdAt])
  @@index([userId])
}

model User {
  id           String   @id @default(cuid())
  supabaseId   String?  @unique
  email        String   @unique
  name         String?
  avatarUrl    String?
  role         String   @default("user")
  passwordHash String?
  currentWeddingId String?
  currentWedding Wedding? @relation("CurrentWedding", fields: [currentWeddingId], references: [id], onDelete: SetNull)

  coupleId String?
  couple   Couple? @relation(fields: [coupleId], references: [id])

  memberships WeddingMembership[]
  assignedPlannerTasks PlannerTask[] @relation("PlannerTaskAssignee")
  ownedBusinesses BusinessAccount[] @relation("BusinessAccountOwner")
  businessMemberships BusinessMembership[]
  createdBusinessAccounts BusinessAccount[] @relation("BusinessAccountCreatedBy")
  updatedBusinessAccounts BusinessAccount[] @relation("BusinessAccountUpdatedBy")
  createdBusinessMemberships BusinessMembership[] @relation("BusinessMembershipCreatedBy")
  updatedBusinessMemberships BusinessMembership[] @relation("BusinessMembershipUpdatedBy")
  businessAuditEvents BusinessAuditEvent[]
  plannerProfileCreated PlannerProfile[] @relation("PlannerProfileCreatedBy")
  plannerProfileUpdated PlannerProfile[] @relation("PlannerProfileUpdatedBy")
  plannerProfileReviews PlannerProfile[] @relation("PlannerProfileReviewedBy")
  plannerShortlists PlannerShortlist[] @relation("PlannerShortlistCreatedBy")
  plannerEnquiries PlannerEnquiry[] @relation("PlannerEnquiryCreatedBy")
  plannerEnquiryResponses PlannerEnquiry[] @relation("PlannerEnquiryRespondedBy")
  couplePlannerEngagements CouplePlannerEngagement[] @relation("CouplePlannerEngagementCreatedBy")
  plannerEngagements CouplePlannerEngagement[] @relation("CouplePlannerEngagementPlannerUser")
  engagementActions PlannerEngagementAction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WeddingMembership {
  id          String   @id @default(cuid())
  role        String
  status      String   @default("active")
  permissions String

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, weddingId])
  @@index([weddingId, role])
  @@index([userId, status])
}

model BusinessAccount {
  id String @id @default(cuid())
  type String
  legalName String
  tradingName String?
  status String @default("pending")
  onboardingStatus String @default("draft")
  ownerUserId String
  ownerUser User @relation("BusinessAccountOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  subscriptionPlanId String?
  stripeCustomerId String?
  stripeSubscriptionId String?
  stripeSubscriptionStatus String?
  subscriptionCurrentPeriodEnd DateTime?
  canonEligible Boolean @default(false)
  canonSealed Boolean @default(false)
  canonSealedAt DateTime?
  canonSealedByUserId String?
  createdByUserId String?
  createdByUser User? @relation("BusinessAccountCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUserId String?
  updatedByUser User? @relation("BusinessAccountUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  plannerProfile PlannerProfile?
  businessMemberships BusinessMembership[]
  auditEvents BusinessAuditEvent[]
  paymentRecords PaymentRecord[]
  couplePlannerEngagements CouplePlannerEngagement[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, status])
  @@index([ownerUserId])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

model BusinessMembership {
  id String @id @default(cuid())
  businessAccountId String
  businessAccount BusinessAccount @relation(fields: [businessAccountId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role String
  status String @default("active")
  createdByUserId String?
  createdByUser User? @relation("BusinessMembershipCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUserId String?
  updatedByUser User? @relation("BusinessMembershipUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessAccountId, userId])
  @@index([userId, status])
  @@index([businessAccountId, role])
}

model BusinessAuditEvent {
  id String @id @default(cuid())
  businessAccountId String?
  businessAccount BusinessAccount? @relation(fields: [businessAccountId], references: [id], onDelete: SetNull)
  actorUserId String?
  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action String
  resourceType String
  resourceId String?
  beforeValue String?
  afterValue String?
  createdAt DateTime @default(now())

  @@index([businessAccountId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
}

model PaymentRecord {
  id String @id @default(cuid())
  businessAccountId String
  businessAccount BusinessAccount @relation(fields: [businessAccountId], references: [id], onDelete: Cascade)
  provider String @default("stripe")
  providerEventId String @unique
  type String
  status String
  amount Int
  currency String @default("usd")
  metadata String?
  occurredAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessAccountId, occurredAt])
  @@index([status, occurredAt])
}

model PlannerProfile {
  id String @id @default(cuid())
  businessAccountId String @unique
  businessAccount BusinessAccount @relation(fields: [businessAccountId], references: [id], onDelete: Cascade)
  slug String @unique
  displayName String
  headline String?
  bio String?
  serviceAreas String
  services String
  weddingStyles String
  priceBand String
  availabilityStatus String @default("available")
  verificationStatus String @default("unverified")
  status String @default("draft")
  publishedAt DateTime?
  createdByUserId String?
  createdByUser User? @relation("PlannerProfileCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUserId String?
  updatedByUser User? @relation("PlannerProfileUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  reviewedByUserId String?
  reviewedByUser User? @relation("PlannerProfileReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt DateTime?
  reviewNote String?
  shortlists PlannerShortlist[]
  enquiries PlannerEnquiry[]
  engagements CouplePlannerEngagement[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, verificationStatus])
  @@index([availabilityStatus, priceBand])
}

model PlannerShortlist {
  id String @id @default(cuid())
  weddingId String
  plannerProfileId String
  plannerProfile PlannerProfile @relation(fields: [plannerProfileId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdByUser User @relation("PlannerShortlistCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([weddingId, plannerProfileId, createdByUserId])
  @@index([createdByUserId, weddingId])
}

model PlannerEnquiry {
  id String @id @default(cuid())
  weddingId String
  plannerProfileId String
  plannerProfile PlannerProfile @relation(fields: [plannerProfileId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdByUser User @relation("PlannerEnquiryCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  message String
  requestedAccessLevel String @default("appointment_only")
  status String @default("open")
  respondedByUserId String?
  respondedByUser User? @relation("PlannerEnquiryRespondedBy", fields: [respondedByUserId], references: [id], onDelete: SetNull)
  respondedAt DateTime?
  responseNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([plannerProfileId, status])
  @@index([createdByUserId, weddingId])
}

model CouplePlannerEngagement {
  id String @id @default(cuid())
  weddingId String
  plannerProfileId String
  plannerProfile PlannerProfile @relation(fields: [plannerProfileId], references: [id], onDelete: Restrict)
  plannerUserId String
  plannerUser User @relation("CouplePlannerEngagementPlannerUser", fields: [plannerUserId], references: [id], onDelete: Restrict)
  enquiryId String?
  createdByUserId String
  createdByUser User @relation("CouplePlannerEngagementCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  accessLevel String @default("appointment_only")
  status String @default("pending_planner_acceptance")
  startedAt DateTime?
  endedAt DateTime?
  pausedAt DateTime?
  acceptedAt DateTime?
  authorizationGrantedAt DateTime?
  revocationReason String?
  lastActionAt DateTime @default(now())
  actions PlannerEngagementAction[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([weddingId, status])
  @@index([plannerUserId, status])
  @@index([plannerProfileId, status])
}

model PlannerEngagementAction {
  id String @id @default(cuid())
  engagementId String
  engagement CouplePlannerEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  action String
  actorUserId String
  actorUser User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  note String?
  fromStatus String?
  toStatus String?
  accessLevel String?
  createdAt DateTime @default(now())

  @@index([engagementId, createdAt])
  @@index([actorUserId, createdAt])
}
