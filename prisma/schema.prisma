  guest           Guest  @relation(fields: [guestId], references: [id])
  weddingId       String
  wedding         Wedding @relation(fields: [weddingId], references: [id])
  type            String @default("memory")
  displayName     String
  relationship    String?
  message         String
  photoUrl        String?
  favoriteSong    String?
  privacy         String @default("public")
  status          String @default("draft")
