generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Couple {
  id                 String   @id @default(cuid())
  slug               String   @unique
  partner1           String
  partner2           String
  surname            String?
  photo              String?
  userId             String?
  subscriptionStatus String   @default("free")

  weddings    Wedding[]
  kids        Kid[]
  users       User[]
  userProfile UserProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Wedding {
  id           String  @id @default(cuid())
  slug         String  @unique
  title        String
  monogram     String?
  tagline      String?
  date         DateTime
  venue        String
  venueCity    String
  venueCountry String
  venueMapUrl  String?

  primaryColor    String @default("#BF9B5F")
  accentColor     String @default("#C0633F")
  memoryColor     String @default("#6B2D3A")
  backgroundColor String @default("#FBF6EE")

  invitationCardStyle   String    @default("botanical")
  invitationCardMessage String?
  rsvpDeadline          DateTime?

  lifecycle        String    @default("before")
  privacy          String    @default("public")
  canonSealed      Boolean   @default(false)
  canonSealedAt    DateTime?
  subscriptionTier String    @default("free")

  coupleId String
  couple   Couple @relation(fields: [coupleId], references: [id])

  guests                  Guest[]
  songs                   Song[]
  media                   MediaItem[]
  messages                Message[]
  products                Product[]
  vendors                 Vendor[]
  programmeItems          ProgrammeItem[]
  plannerTasks            PlannerTask[]
  budgetItems             BudgetItem[]
  serviceEngagements      ServiceEngagement[]
  vaultObjects            VaultObject[]
  seatingTables           SeatingTable[]
  importJobs              ImportJob[]
  contentRevisions        ContentRevision[]
  contentSubmissions      ContentSubmission[]
  auditEvents             AuditEvent[]
  googleSheetsConnections GoogleSheetsConnection[]
  qrDestinations          QRDestination[]
  themePreferences        ThemePreference[]
  guestContributions      GuestContribution[]
  contentItems            WeddingContent[]
  comments                Comment[]
  memberships             WeddingMembership[]
  currentForUsers         User[] @relation("CurrentWedding")
  notifications           Notification[]
  reminders               Reminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Guest {
  id                 String  @id @default(cuid())
  name               String
  email              String?
  phone              String?
  role               String  @default("guest")
  roleDetail         String?
  side               String?
  tableNumber        Int?
  seatingTableId     String?
  seatingTable       SeatingTable? @relation(fields: [seatingTableId], references: [id])
  contributionToken  String? @unique
  contributionStatus String? @default("none")

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])

  rsvp         RSVP?
  contribution GuestContribution?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RSVP {
  id            String   @id @default(cuid())
  token         String   @unique
  attending     Boolean?
  mealChoice    String?
  plusOne       Boolean  @default(false)
  plusOneName   String?
  plusOneMeal   String?
  kidsAttending Boolean  @default(false)
  kidsCount     Int      @default(0)
  songRequests  String?
  dietaryNotes  String?
  message       String?
  checkedIn     Boolean  @default(false)
  checkedInAt   DateTime?

  guestId String @unique
  guest   Guest  @relation(fields: [guestId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Song {
  id         String    @id @default(cuid())
  title      String
  artist     String
  phase      String
  moment     String?
  order      Int       @default(0)
  votes      Int       @default(0)
  spotifyUrl String?
  appleUrl   String?
  playedAt   DateTime?
  notes      String?

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MediaItem {
  id           String    @id @default(cuid())
  type         String
  url          String
  thumbnailUrl String?
  caption      String?
  moment       String?
  isCurated    Boolean   @default(false)
  isHero       Boolean   @default(false)
  uploaderId   String?
  userId       String?
  user         UserProfile? @relation(fields: [userId], references: [id])
  uploadedAt   DateTime?

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id          String    @id @default(cuid())
  type        String
  content     String
  authorName  String
  authorToken String?
  userId      String?
  user        UserProfile? @relation(fields: [userId], references: [id])
  isPublic    Boolean   @default(true)
  revealedAt  DateTime?

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String  @id @default(cuid())
  name        String
  description String?
  price       Float
  currency    String  @default("USD")
  imageUrl    String?
  category    String?
  inStock     Boolean @default(true)

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vendor {
  id             String  @id @default(cuid())
  name           String
  category       String
  description    String?
  website        String?
  phone          String?
  email          String?
  imageUrl       String?
  rating         Float?
  featured       Boolean @default(false)
  contact        String?
  contractStatus String  @default("pending")
  paymentStatus  String  @default("unpaid")
  planningRating Float?
  notes          String?

  weddingId          String
  wedding            Wedding             @relation(fields: [weddingId], references: [id])
  budgetItems        BudgetItem[]
  serviceEngagements ServiceEngagement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, weddingId])
}

model ProgrammeItem {
  id          String @id @default(cuid())
  time        String
  title       String
  description String?
  icon        String?
  duration    String?
  location    String?
  displayIcon String?
  order       Int    @default(0)

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Kid {
  id       String @id @default(cuid())
  name     String
  gender   String
  age      Int?
  photoUrl String?

  coupleId String
  couple   Couple @relation(fields: [coupleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlannerTask {
  id             String   @id @default(cuid())
  title          String
  description    String?
  category       String
  status         String   @default("todo")
  priority       String   @default("medium")
  dueDate        DateTime?
  assignee       String?
  assigneeUserId String?
  assigneeUser   User?    @relation("PlannerTaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  order          Int      @default(0)

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assigneeUserId])
}

model BudgetItem {
  id                  String   @id @default(cuid())
  category            String
  description         String
  estimatedCost       Float
  actualCost          Float?
  paidAmount          Float    @default(0)
  currency            String   @default("USD")
  vendorId            String?
  vendorName          String?
  notes               String?
  dueDate             DateTime?
  serviceEngagementId String?

  weddingId         String
  wedding           Wedding            @relation(fields: [weddingId], references: [id])
  vendor            Vendor?            @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  serviceEngagement ServiceEngagement? @relation(fields: [serviceEngagementId, weddingId], references: [id, weddingId], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, weddingId])
  @@index([vendorId])
  @@index([serviceEngagementId])
}

model ServiceEngagement {
  id                         String   @id @default(cuid())
  origin                     String   @default("historical")
  recordMode                 String   @default("record_only")
  lifecycleStatus            String   @default("historical_capture")
  serviceCategory            String
  serviceDescription         String?
  agreedAmount               Decimal? @db.Decimal(14, 2)
  currency                   String   @default("USD")
  serviceDate                DateTime?
  serviceLocation            String?
  externalAgreementStatus    String   @default("unknown")
  externalAgreementReference String?
  historicalBasis            String?
  recordedById               String?
  createdById                String?

  weddingId   String
  wedding     Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  vendorId    String
  vendor      Vendor  @relation(fields: [vendorId, weddingId], references: [id, weddingId], onDelete: Restrict)

  budgetItems BudgetItem[]
  payments    EngagementPayment[]
  parties     EngagementParty[]
  contracts   Contract[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, weddingId])
  @@index([weddingId, origin])
  @@index([weddingId, lifecycleStatus])
  @@index([vendorId, weddingId])
  @@index([serviceDate])
}

model EngagementPayment {
  id                  String   @id @default(cuid())
  amount              Decimal  @db.Decimal(14, 2)
  currency            String   @default("USD")
  paidAt              DateTime?
  method              String?
  reference           String?
  notes               String?
  recordedById        String?
  serviceEngagementId String
  serviceEngagement   ServiceEngagement @relation(fields: [serviceEngagementId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceEngagementId, paidAt])
  @@index([reference])
}

model VaultObject {
  id               String   @id @default(cuid())
  storageProvider  String
  objectKey        String   @unique
  originalFilename String
  displayName      String
  mimeType         String
  extension        String?
  byteSize         BigInt
  checksumSha256   String
  uploaderActorId  String?
  uploadSource     String
  storageState     String   @default("registered")
  scanState        String   @default("pending")
  retentionClass   String   @default("wedding_record")
  legalHold        Boolean  @default(false)
  sensitivity      String   @default("private")
  publicationState String   @default("private")
  metadata         String?
  archivedAt       DateTime?
  deletedAt        DateTime?

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  links     VaultLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, weddingId])
  @@index([weddingId, createdAt])
  @@index([checksumSha256])
  @@index([storageState, scanState])
}

model VaultLink {
  id            String @id @default(cuid())
  vaultObjectId String
  weddingId     String
  entityType    String
  entityId      String
  linkRole      String
  createdById   String?

  vaultObject VaultObject @relation(fields: [vaultObjectId, weddingId], references: [id, weddingId], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([vaultObjectId, entityType, entityId, linkRole])
  @@index([weddingId, entityType, entityId])
  @@index([entityType, entityId])
}

model EngagementParty {
  id                  String @id @default(cuid())
  serviceEngagementId String
  weddingId           String
  partyRole           String
  partyKind           String
  displayName         String
  legalName           String?
  email               String?
  phone               String?
  userId              String?
  entityId            String?
  authorityBasis      String?
  requiredForReview   Boolean @default(true)
  status              String  @default("active")
  createdById         String?

  serviceEngagement ServiceEngagement @relation(fields: [serviceEngagementId, weddingId], references: [id, weddingId], onDelete: Cascade)
  reviewGrants      ContractReviewGrant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceEngagementId, status, partyRole])
  @@index([serviceEngagementId, weddingId])
  @@index([weddingId, partyRole])
}

model ContractTemplate {
  id                 String   @id @default(cuid())
  code               String
  title               String
  serviceCategory    String
  marketCode         String   @default("GLOBAL")
  jurisdictionCode   String?
  language           String   @default("en")
  semanticVersion    String
  status              String   @default("internal_review")
  reviewStatus        String   @default("operator_review")
  effectiveFrom       DateTime?
  retiredAt           DateTime?
  summary             String?
  templateHash        String
  metadata            String?
  createdById         String?

  clauses   ContractTemplateClause[]
  contracts Contract[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code, semanticVersion, marketCode])
  @@index([serviceCategory, marketCode, status])
}

model ContractClause {
  id           String @id @default(cuid())
  code         String
  version      String
  title        String
  clauseFamily String
  body         String @db.Text
  status       String @default("internal_review")
  reviewStatus String @default("operator_review")
  contentHash  String
  createdById  String?

  templates ContractTemplateClause[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code, version])
  @@index([clauseFamily, status])
}

model ContractTemplateClause {
  id            String @id @default(cuid())
  templateId    String
  clauseId      String
  position      Int     @default(0)
  required      Boolean @default(true)
  configuration String?

  template ContractTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  clause   ContractClause   @relation(fields: [clauseId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([templateId, clauseId])
  @@index([templateId, position, id])
  @@index([clauseId])
}

model Contract {
  id                   String @id @default(cuid())
  contractNumber       String @unique
  serviceEngagementId  String
  weddingId            String
  templateId           String
  status               String @default("DRAFT")
  currentVersionNumber Int    @default(0)
  title                String
  createdById          String?
  issuedAt             DateTime?
  closedAt             DateTime?

  serviceEngagement ServiceEngagement @relation(fields: [serviceEngagementId, weddingId], references: [id, weddingId], onDelete: Restrict)
  template          ContractTemplate  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  versions          ContractVersion[]
  reviewGrants      ContractReviewGrant[]
  events            ContractEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, weddingId])
  @@index([serviceEngagementId, status, createdAt])
  @@index([serviceEngagementId, weddingId])
  @@index([templateId])
  @@index([weddingId, status, createdAt])
}

model ContractVersion {
  id                      String @id @default(cuid())
  contractId              String
  weddingId               String
  versionNumber           Int
  status                  String @default("DRAFT")
  templateSemanticVersion String
  canonicalJson           String @db.Text
  renderedHtml            String @db.Text
  contentSha256           String?
  artifactVaultObjectId   String?
  artifactSha256          String?
  issuedAt                DateTime?
  createdById             String?

  contract     Contract              @relation(fields: [contractId, weddingId], references: [id, weddingId], onDelete: Restrict)
  reviewGrants ContractReviewGrant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contractId, versionNumber])
  @@unique([id, contractId])
  @@index([contractId, status, versionNumber])
  @@index([contractId, weddingId])
  @@index([artifactVaultObjectId])
}

model ContractReviewGrant {
  id                  String @id @default(cuid())
  contractId          String
  contractVersionId   String
  engagementPartyId   String?
  role                String
  tokenHash           String @unique
  status              String @default("ACTIVE")
  expiresAt           DateTime
  revokedAt           DateTime?
  lastAccessedAt      DateTime?
  createdById         String?

  contract        Contract         @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractVersion ContractVersion  @relation(fields: [contractVersionId, contractId], references: [id, contractId], onDelete: Cascade)
  engagementParty EngagementParty? @relation(fields: [engagementPartyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([contractVersionId, status, expiresAt])
  @@index([contractId])
  @@index([contractVersionId, contractId])
  @@index([engagementPartyId])
}

model ContractEvent {
  id         String @id @default(cuid())
  contractId String
  versionId  String?
  eventType  String
  actorId    String?
  metadata   String?

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([contractId, createdAt, id])
}

model SeatingTable {
  id       String  @id @default(cuid())
  name     String
  capacity Int     @default(8)
  position String?

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])
  guests    Guest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String?
  passwordHash     String?
  role             String   @default("viewer")
  coupleId         String?
  couple           Couple?  @relation(fields: [coupleId], references: [id])
  currentWeddingId String?
  currentWedding   Wedding? @relation("CurrentWedding", fields: [currentWeddingId], references: [id], onDelete: SetNull)
  isActive         Boolean  @default(true)
  lastLoginAt      DateTime?

  auditEvents             AuditEvent[]
  contentRevisions        ContentRevision[]
  contentSubmissions      ContentSubmission[]
  memberships             WeddingMembership[] @relation("MembershipUser")
  invitationsSent         WeddingMembership[] @relation("MembershipInviter")
  assignedPlannerTasks    PlannerTask[] @relation("PlannerTaskAssignee")
  notificationsReceived   Notification[] @relation("NotificationRecipient")
  notificationsActed      Notification[] @relation("NotificationActor")
  remindersOwned          Reminder[] @relation("ReminderOwner")
  remindersReceived       Reminder[] @relation("ReminderRecipient")
  notificationPreferences NotificationPreference[]
  pushSubscriptions       PushSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([currentWeddingId])
}

model Notification {
  id             String  @id
  recipientUserId String
  weddingId       String?
  actorUserId     String?
  sourceType      String
  sourceId        String?
  eventType       String
  category        String
  severity        String  @default("normal")
  title           String
  body            String
  metadata        Json?   @db.JsonB
  deepLink        String?
  actionType      String?
  requiresAction  Boolean @default(false)
  state           String  @default("active")
  readAt          DateTime? @db.Timestamptz(6)
  acknowledgedAt  DateTime? @db.Timestamptz(6)
  resolvedAt      DateTime? @db.Timestamptz(6)
  scheduledFor    DateTime? @db.Timestamptz(6)
  snoozedUntil    DateTime? @db.Timestamptz(6)
  expiresAt       DateTime? @db.Timestamptz(6)
  dedupeKey       String?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  recipient          User   @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Notification_recipientUserId_fkey")
  wedding            Wedding? @relation(fields: [weddingId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Notification_weddingId_fkey")
  actor              User?  @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Notification_actorUserId_fkey")
  deliveryAttempts   NotificationDeliveryAttempt[]
  generatedReminders Reminder[] @relation("ReminderGeneratedNotification")

  @@index([recipientUserId, state, createdAt(sort: Desc)], map: "Notification_recipient_state_created_idx")
  @@index([recipientUserId, readAt, createdAt(sort: Desc)], map: "Notification_recipient_read_created_idx")
  @@index([weddingId, category, createdAt(sort: Desc)], map: "Notification_wedding_category_idx")
  @@index([sourceType, sourceId], map: "Notification_source_idx")
}

model Reminder {
  id                      String @id
  ownerUserId             String
  recipientUserId         String
  weddingId               String?
  sourceType              String
  sourceId                String?
  triggerAt               DateTime @db.Timestamptz(6)
  timezone                String @default("UTC")
  state                   String @default("scheduled")
  deliveryPolicy          Json? @db.JsonB
  dedupeKey               String?
  generatedNotificationId String?
  snoozedFromReminderId   String?
  triggeredAt             DateTime? @db.Timestamptz(6)
  cancelledAt             DateTime? @db.Timestamptz(6)
  lastError               String?
  createdAt               DateTime @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  owner                 User @relation("ReminderOwner", fields: [ownerUserId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Reminder_ownerUserId_fkey")
  recipient             User @relation("ReminderRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Reminder_recipientUserId_fkey")
  wedding               Wedding? @relation(fields: [weddingId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Reminder_weddingId_fkey")
  generatedNotification Notification? @relation("ReminderGeneratedNotification", fields: [generatedNotificationId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Reminder_generatedNotificationId_fkey")
  snoozedFromReminder   Reminder? @relation("ReminderSnooze", fields: [snoozedFromReminderId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Reminder_snoozedFromReminderId_fkey")
  snoozedReminders      Reminder[] @relation("ReminderSnooze")

  @@index([state, triggerAt], map: "Reminder_schedule_idx")
  @@index([recipientUserId, state, triggerAt], map: "Reminder_recipient_schedule_idx")
  @@index([weddingId, state, triggerAt], map: "Reminder_wedding_schedule_idx")
  @@index([sourceType, sourceId], map: "Reminder_source_idx")
}

model NotificationPreference {
  id              String @id
  userId          String
  scopeKey        String @default("global")
  inAppEnabled    Boolean @default(true)
  pushEnabled     Boolean @default(false)
  emailEnabled    Boolean @default(false)
  whatsAppEnabled Boolean @default(false)
  timezone        String @default("UTC")
  quietStart      String?
  quietEnd        String?
  digestMode      String @default("none")
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "NotificationPreference_userId_fkey")

  @@unique([userId, scopeKey], map: "NotificationPreference_user_scope_unique")
  @@index([userId], map: "NotificationPreference_user_idx")
}

model NotificationDeliveryAttempt {
  id             String @id
  notificationId String
  channel        String
  state          String @default("queued")
  providerRef    String?
  errorCode      String?
  errorMessage   String?
  attemptedAt    DateTime? @db.Timestamptz(6)
  sentAt         DateTime? @db.Timestamptz(6)
  deliveredAt    DateTime? @db.Timestamptz(6)
  readAt         DateTime? @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "NotificationDeliveryAttempt_notificationId_fkey")

  @@index([notificationId, createdAt(sort: Desc)], map: "NotificationDeliveryAttempt_notification_idx")
  @@index([channel, state, createdAt], map: "NotificationDeliveryAttempt_channel_state_idx")
}

model PushSubscription {
  id             String @id
  userId         String
  endpoint       String @unique(map: "PushSubscription_endpoint_unique")
  p256dh         String
  auth           String
  expirationTime BigInt?
  userAgent      String?
  disabledAt     DateTime? @db.Timestamptz(6)
  lastSeenAt     DateTime @default(now()) @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "PushSubscription_userId_fkey")

  @@index([userId, disabledAt, lastSeenAt(sort: Desc)], map: "PushSubscription_user_active_idx")
}

model WeddingMembership {
  id          String @id @default(cuid())
  userId      String
  user        User   @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  weddingId   String
  wedding     Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  role        String @default("planner")
  status      String @default("invited")
  permissions String?
  invitedById String?
  invitedBy   User?  @relation("MembershipInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, weddingId])
  @@index([weddingId, status])
  @@index([userId, status])
}

model ImportJob {
