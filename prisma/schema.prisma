generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Couple {
  id                 String   @id @default(cuid())
  slug               String   @unique
  partner1           String
  partner2           String
  surname            String?
  photo              String?
  userId             String?
  subscriptionStatus String   @default("free")

  weddings   Wedding[]
  kids       Kid[]
  users      User[]
  userProfile UserProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Wedding {
  id           String  @id @default(cuid())
  slug         String  @unique
  title        String
  monogram     String?
  tagline      String?
  date         DateTime
  venue        String
  venueCity    String
  venueCountry String
  venueMapUrl  String?

  primaryColor    String @default("#BF9B5F")
  accentColor     String @default("#C0633F")
  memoryColor     String @default("#6B2D3A")
  backgroundColor String @default("#FBF6EE")

  invitationCardStyle   String    @default("botanical")
  invitationCardMessage String?
  rsvpDeadline          DateTime?

  lifecycle       String    @default("before")
  privacy         String    @default("public")
  canonSealed     Boolean   @default(false)
  canonSealedAt   DateTime?
  subscriptionTier String   @default("free")

  coupleId String
  couple   Couple @relation(fields: [coupleId], references: [id])

  guests                  Guest[]
  songs                   Song[]
  media                   MediaItem[]
  messages                Message[]
  products                Product[]
  vendors                 Vendor[]
  programmeItems          ProgrammeItem[]
  plannerTasks            PlannerTask[]
  budgetItems             BudgetItem[]
  seatingTables           SeatingTable[]
  importJobs              ImportJob[]
  contentRevisions        ContentRevision[]
  contentSubmissions      ContentSubmission[]
  auditEvents             AuditEvent[]
  googleSheetsConnections GoogleSheetsConnection[]
  qrDestinations          QRDestination[]
  themePreferences        ThemePreference[]
  guestContributions      GuestContribution[]
  contentItems            WeddingContent[]
  comments                Comment[]
  memberships             WeddingMembership[]
  currentForUsers         User[] @relation("CurrentWedding")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Guest {
  id                  String  @id @default(cuid())
  name                String
  email               String?
  phone               String?
  role                String  @default("guest")
  roleDetail          String?
  side                String?
  tableNumber         Int?
  seatingTableId      String?
  seatingTable        SeatingTable? @relation(fields: [seatingTableId], references: [id])
  contributionToken   String? @unique
  contributionStatus  String? @default("none")

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])

  rsvp         RSVP?
  contribution GuestContribution?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RSVP {
  id             String   @id @default(cuid())
  token          String   @unique
  attending      Boolean?
  mealChoice     String?
  plusOne        Boolean  @default(false)
  plusOneName    String?
  plusOneMeal    String?
  kidsAttending  Boolean  @default(false)
  kidsCount      Int      @default(0)
  songRequests   String?
  dietaryNotes   String?
  message        String?
  checkedIn      Boolean  @default(false)
  checkedInAt    DateTime?

  guestId String @unique
  guest   Guest  @relation(fields: [guestId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Song {
  id         String    @id @default(cuid())
  title      String
  artist     String
  phase      String
  moment     String?
  order      Int       @default(0)
  votes      Int       @default(0)
  spotifyUrl String?
  appleUrl   String?
  playedAt   DateTime?
  notes      String?

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MediaItem {
  id           String    @id @default(cuid())
  type         String
  url          String
  thumbnailUrl String?
  caption      String?
  moment       String?
  isCurated    Boolean   @default(false)
  isHero       Boolean   @default(false)
  uploaderId   String?
  userId       String?
  user         UserProfile? @relation(fields: [userId], references: [id])
  uploadedAt   DateTime?

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id          String    @id @default(cuid())
  type        String
  content     String
  authorName  String
  authorToken String?
  userId      String?
  user        UserProfile? @relation(fields: [userId], references: [id])
  isPublic    Boolean   @default(true)
  revealedAt  DateTime?

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String  @id @default(cuid())
  name        String
  description String?
  price       Float
  currency    String  @default("USD")
  imageUrl    String?
  category    String?
  inStock     Boolean @default(true)

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vendor {
  id             String  @id @default(cuid())
  name           String
  category       String
  description    String?
  website        String?
  phone          String?
  imageUrl       String?
  rating         Float?
  featured       Boolean @default(false)
  contact        String?
  contractStatus String  @default("pending")
  paymentStatus  String  @default("unpaid")
  planningRating Float?
  notes          String?

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProgrammeItem {
  id          String @id @default(cuid())
  time        String
  title       String
  description String?
  icon        String?
  duration    String?
  location    String?
  displayIcon String?
  order       Int    @default(0)

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Kid {
  id       String @id @default(cuid())
  name     String
  gender   String
  age      Int?
  photoUrl String?

  coupleId String
  couple   Couple @relation(fields: [coupleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlannerTask {
  id             String   @id @default(cuid())
  title          String
  description    String?
  category       String
  status         String   @default("todo")
  priority       String   @default("medium")
  dueDate        DateTime?
  assignee       String?
  assigneeUserId String?
  assigneeUser   User?    @relation("PlannerTaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  order          Int      @default(0)

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assigneeUserId])
}

model BudgetItem {
  id            String   @id @default(cuid())
  category      String
  description   String
  estimatedCost Float
  actualCost    Float?
  paidAmount    Float    @default(0)
  currency      String   @default("USD")
  vendorId      String?
  vendorName    String?
  notes         String?
  dueDate       DateTime?

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SeatingTable {
  id       String  @id @default(cuid())
  name     String
  capacity Int     @default(8)
  position String?

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])
  guests    Guest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                   String   @id @default(cuid())
  email                String   @unique
  name                 String?
  passwordHash         String?
  role                 String   @default("viewer")
  coupleId             String?
  couple               Couple?  @relation(fields: [coupleId], references: [id])
  currentWeddingId     String?
  currentWedding       Wedding? @relation("CurrentWedding", fields: [currentWeddingId], references: [id], onDelete: SetNull)
  isActive             Boolean  @default(true)
  lastLoginAt          DateTime?

  auditEvents          AuditEvent[]
  contentRevisions     ContentRevision[]
  contentSubmissions   ContentSubmission[]
  memberships          WeddingMembership[] @relation("MembershipUser")
  invitationsSent      WeddingMembership[] @relation("MembershipInviter")
  assignedPlannerTasks PlannerTask[] @relation("PlannerTaskAssignee")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([currentWeddingId])
}

model WeddingMembership {
  id          String @id @default(cuid())
  userId      String
  user        User   @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  weddingId   String
  wedding     Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  role        String @default("planner")
  status      String @default("invited")
  permissions String?
  invitedById String?
  invitedBy   User?  @relation("MembershipInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, weddingId])
  @@index([weddingId, status])
  @@index([userId, status])
}

model ImportJob {
  id              String @id @default(cuid())
  moduleKey       String
  fileName        String
  templateVersion String?
  status          String @default("preview")
  totalRows       Int    @default(0)
  createdCount    Int    @default(0)
  updatedCount    Int    @default(0)
  skippedCount    Int    @default(0)
  errorCount      Int    @default(0)
  errorReport     String?
  rollbackToken   String?
  rollbackData    String?
  fieldMapping    String?
  previewData     String?

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])
  performedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContentRevision {
  id            String   @id @default(cuid())
  section       String
  fieldKey      String
  value         String
  status        String   @default("draft")
  previousValue String?

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])
  authorId  String?
  author    User?   @relation(fields: [authorId], references: [id])

  publishedAt  DateTime?
  scheduledFor DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ContentSubmission {
  id             String   @id @default(cuid())
  type           String
  content        String
  authorName     String
  authorEmail    String?
  status         String   @default("pending")
  moderatorNotes String?

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])
  authorId  String?
  author    User?   @relation(fields: [authorId], references: [id])

  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AuditEvent {
  id           String @id @default(cuid())
  action       String
  resourceType String
  resourceId   String?
  beforeValue  String?
  afterValue   String?
  ipAddress    String?
  userAgent    String?

  weddingId String?
  wedding   Wedding? @relation(fields: [weddingId], references: [id])
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])

  createdAt DateTime @default(now())
}

model GoogleSheetsConnection {
  id              String   @id @default(cuid())
  spreadsheetId   String
  spreadsheetName String?
  sheetTab        String?
  moduleKey       String
  accessToken     String?
  refreshToken    String?
  tokenExpiry     DateTime?
  lastSyncAt      DateTime?
  lastSyncStatus  String?
  lastSyncError   String?
  isActive        Boolean  @default(true)

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QRDestination {
  id        String  @id @default(cuid())
  label     String
  url       String
  type      String  @default("website")
  scanCount Int     @default(0)
  isActive  Boolean @default(true)

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ThemePreference {
  id        String @id @default(cuid())
  theme     String @default("system")
  userId    String?
  weddingId String?
  wedding   Wedding? @relation(fields: [weddingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GuestContribution {
  id           String @id @default(cuid())
  guestId      String @unique
  guest        Guest  @relation(fields: [guestId], references: [id])
  weddingId    String
  wedding      Wedding @relation(fields: [weddingId], references: [id])
  type         String @default("memory")
  displayName  String
  relationship String?
  message      String
  photoUrl     String?
  favoriteSong String?
  privacy      String @default("public")
  status       String @default("draft")
  moderatorNotes String?
  wordCount    Int @default(0)
  charCount    Int @default(0)
  editCount    Int @default(0)
  revisionHistory String?
  submittedAt  DateTime?
  reviewedAt   DateTime?
  reviewedBy   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WeddingContent {
  id        String @id @default(cuid())
  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])
  section   String
  field     String
  value     String
  order     Int    @default(0)
  metadata  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([weddingId, section, field])
}

model UserProfile {
  id                 String @id
  email              String @unique
  displayName        String?
  avatarUrl          String?
  bio                String?
  role               String @default("viewer")
  coupleId           String? @unique
  couple             Couple? @relation(fields: [coupleId], references: [id])
  emailNotifications Boolean @default(true)
  marketingEmails    Boolean @default(false)
  isBanned           Boolean @default(false)
  bannedAt           DateTime?
  banReason          String?
  lastLoginAt        DateTime?

  comments   Comment[]
  mediaItems MediaItem[]
  messages   Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comment {
  id         String @id @default(cuid())
  body       String
  targetType String
  targetId   String
  weddingId  String
  wedding    Wedding @relation(fields: [weddingId], references: [id])
  authorId   String
  author     UserProfile @relation(fields: [authorId], references: [id])
  parentId   String?
  parent     Comment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies    Comment[] @relation("CommentReplies")
  status     String @default("published")
  flaggedAt  DateTime?
  flagReason String?
  hiddenAt   DateTime?
  hiddenBy   String?
  likeCount  Int @default(0)
  likedBy    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([targetType, targetId])
  @@index([weddingId, status])
  @@index([authorId])
}

model AiRateLimitBucket {
  keyHash     String
  windowStart DateTime @db.Timestamptz(6)
  count       Int      @default(1)
  expiresAt   DateTime @db.Timestamptz(6)

  @@id([keyHash, windowStart])
  @@index([expiresAt])
}
