  content        String
  authorName     String
  authorEmail    String?
  status         String   @default("pending")
  moderatorNotes String?

  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id])
  authorId  String?
  author    User?   @relation(fields: [authorId], references: [id])

  reviewedBy String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
