# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

# The bare `test` rule above matches ANY directory named `test`, which silently swallowed the
# native Android unit-test sources and made a clean checkout fail to compile. Native test trees
# are first-class source and must always be tracked. The directory itself has to be un-ignored
# before files inside it can be.
!apps/android/app/src/test/
!apps/android/app/src/test/**
!apps/android/app/src/androidTest/
!apps/android/app/src/androidTest/**
!apps/ios/Wewed/Tests/
!apps/ios/Wewed/Tests/**

server.log
# Skills directory
/skills/

# ── Production backend (Task 24) ──────────────────────────────
# Database files (SQLite local dev — NEVER commit these)
db/*.db
db/*.db-journal
prisma/*.db
prisma/*.db-journal

# Uploaded files (local dev fallback — use Supabase Storage in prod)
upload/
public/uploads/

# Tool results / scratch
tool-results/

# Z.AI workspace runtime files (keep the .sh scripts, ignore runtime output)
.zscripts/dev.pid
.zscripts/*.log

# Native Mobile Build Artifacts
apps/android/.gradle/
apps/android/build/
apps/android/app/build/
apps/android/local.properties
apps/ios/.build/
apps/ios/build/
apps/ios/DerivedData/
apps/ios/*.xcodeproj/xcuserdata/
apps/ios/*.xcworkspace/xcuserdata/

# Private Real Shadow & UAT Identity Material (NEVER commit real identity data)
*private-real-shadow*
*.private.json
.private/
**/private-shadow/
mobile/fixtures/private/
apps/ios/**/PrivateRealShadow*Data.swift
apps/android/**/PrivateRealShadow*Data.kt
# Python bytecode from the shadow tooling
__pycache__/
*.pyc
